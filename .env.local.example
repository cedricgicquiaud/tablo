# Supabase — fournis par `supabase status` après `supabase start` (ou par le dashboard Supabase pour la prod)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role : NE JAMAIS exposer côté client. Utilisée uniquement par les scripts seed / migrations.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — pour le générateur AI de widgets (Phase 15+).
# Récupère-la sur https://console.anthropic.com/settings/keys.
# Server-side only, jamais exposée au browser.
ANTHROPIC_API_KEY=

# Phase 14.1 — Connecteur Supabase OAuth.
# Clé AES-256-GCM (32 bytes hex = 64 chars) pour chiffrer les tokens OAuth en DB.
# Générer via : openssl rand -hex 32
# EN PROD : générer une clé différente et la stocker dans un secret manager.
CONNECTOR_ENCRYPTION_KEY=

# OAuth app Supabase — à enregistrer dans une org Supabase → "OAuth Apps".
# https://supabase.com/docs/guides/integrations/build-a-supabase-oauth-integration
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# En dev : http://localhost:3000/oauth/supabase/callback
# En prod : https://<domain>/oauth/supabase/callback
SUPABASE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/supabase/callback

# Phase 17 — Feature flag suggest_follow_ups (default: true si non défini).
# Si 'false' → tool retiré de la liste exposée au LLM, pas de chips follow-up
# affichés sous les widgets. Toggle pour A/B test ou désactiver si pas de valeur.
AI_ENGINE_FOLLOW_UPS_ENABLED=true
