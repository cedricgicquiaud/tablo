# Supabase — fournis par `supabase status` après `supabase start` (ou par le dashboard Supabase pour la prod)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role : NE JAMAIS exposer côté client. Utilisée uniquement par les scripts seed / migrations.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — pour le générateur AI de widgets (Phase 15+).
# Récupère-la sur https://console.anthropic.com/settings/keys.
# Server-side only, jamais exposée au browser.
ANTHROPIC_API_KEY=
