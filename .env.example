# Tablo — environment variables template.
# Copy to .env.local and fill in your own values.

# ============================================================
# Supabase (local dev: bunx supabase start fournit les valeurs)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# Anthropic (moteur AI Tablo — Phase 17)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Crypto (chiffrement AES-256-GCM des tokens OAuth — P14.1)
# ============================================================
CONNECTOR_ENCRYPTION_KEY=  # 32 bytes hex random — `openssl rand -hex 32`

# ============================================================
# Supabase OAuth (Phase 14.1 — connecter SA DB Postgres)
# ============================================================
SUPABASE_OAUTH_CLIENT_ID=  # cf https://supabase.com/dashboard → OAuth Apps
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/supabase/callback

# ============================================================
# Stripe (Phase 14.2 démo seed + Phase 14.3 DataSource démo)
# ============================================================
STRIPE_SECRET_KEY=sk_test_...  # refus sk_live_
CRM_DEMO_DATABASE_URL=postgresql://...

# ============================================================
# Stripe Connect Platform (Phase 14.4 — OAuth user-owned)
# ============================================================
# Setup : dashboard.stripe.com → Settings → Connect → Standard accounts
# Redirect URI à enregistrer : http://localhost:3000/oauth/stripe/callback
# Récup le client_id qui commence par ca_test_...
STRIPE_CONNECT_CLIENT_ID=ca_test_...

# ============================================================
# Airtable OAuth (Phase 14.5 — connecter une base Airtable user-owned)
# ============================================================
# Setup : https://airtable.com/create/oauth → Register integration "Tablo"
# Redirect URI à enregistrer : http://localhost:3000/oauth/airtable/callback
# Scopes : data.records:read schema.bases:read user.email:read
AIRTABLE_OAUTH_CLIENT_ID=
AIRTABLE_OAUTH_CLIENT_SECRET=
AIRTABLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/airtable/callback
